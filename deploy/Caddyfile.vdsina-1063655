pochtinormalnye.ru {
    root * /srv/pochtinormalnye-site
    encode zstd gzip

    handle /nafanya-zoom-control/* {
        reverse_proxy https://89.124.123.138 {
            header_up Host pochtinormalnye.ru
            transport http {
                tls_server_name pochtinormalnye.ru
            }
        }
    }

    handle_path /support-chat-api/* {
        reverse_proxy https://pn-support-chat.pochtinormalnye.workers.dev {
            header_up Host pn-support-chat.pochtinormalnye.workers.dev
            header_up X-PN-Visitor-IP {http.request.header.CF-Connecting-IP}
            transport http {
                tls_server_name pn-support-chat.pochtinormalnye.workers.dev
            }
        }
    }

    handle /support-chat-max-api-* {
        reverse_proxy https://89.124.123.138 {
            header_up Host pochtinormalnye.ru
            transport http {
                tls_server_name pochtinormalnye.ru
            }
        }
    }

    @private path /.git* /.agents* /.codex* /.gitignore /.htaccess /README.md /admin/.htaccess /cms.php /site-page.php /sitemap.php /site-search.php /site-search-lib.php /archive-lib.php /archive-protocol-import.php /cms-config.php /cms-config.example.php /cms-data* /cms-backups* /support-chat-worker*
    handle @private {
        respond 404
    }

    handle /site-search.json {
        header Cache-Control "public, max-age=60"
        reverse_proxy 127.0.0.1:8091
    }

    @cms path / /index.html /newcomers.html /tradition.html /cms-navigation.json /sitemap.xml /p/* /admin* /setup.php /public.php /announcements.html /schedule.html /library.html /speakers.html /service.html /archive.html
    handle @cms {
        header Cache-Control "no-store"
        reverse_proxy 127.0.0.1:8091
    }

    handle {
        header Cache-Control "public, max-age=300"
        file_server
    }
}

www.pochtinormalnye.ru {
    redir https://pochtinormalnye.ru{uri} permanent
}

