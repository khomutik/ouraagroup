Options -Indexes
RewriteEngine On

<IfModule php_module>
  php_value upload_max_filesize 16M
  php_value post_max_size 32M
  php_value max_file_uploads 20
</IfModule>

# Keep the public addresses that are already indexed and shared in messages.
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^site-search\.json$ site-search.php [L]
RewriteRule ^announcements\.html$ public.php?section=announcements [L,QSA]
RewriteRule ^schedule\.html$ public.php?section=schedule [L,QSA]
RewriteRule ^library\.html$ public.php?section=library [L,QSA]
RewriteRule ^speakers\.html$ public.php?section=speakers [L,QSA]
RewriteRule ^service\.html$ public.php?section=services [L,QSA]
RewriteRule ^archive\.html$ public.php?section=archive [L,QSA]
RewriteRule ^$ site-page.php?kind=home [L,QSA]
RewriteRule ^index\.html$ site-page.php?kind=home [L,QSA]
RewriteRule ^newcomers\.html$ site-page.php?kind=newcomers [L,QSA]
RewriteRule ^tradition\.html$ site-page.php?kind=tradition [L,QSA]
RewriteRule ^cms-navigation\.json$ site-page.php?navigation=1 [L,QSA]
# This retired page is kept as a draft in the CMS; send old search links to the relevant page.
RewriteRule ^p/kak-perestat-pit/?$ https://pochtinormalnye.ru/newcomers.html [R=301,L]
RewriteRule ^p/([a-z0-9-]+)/?$ site-page.php?kind=custom&slug=$1 [L,QSA]

# CMS data and local configuration must never be served as files.
RewriteRule ^(?:cms-data|cms-backups|support-chat-worker)(?:/|$) - [F,L]
<FilesMatch "^(?:cms-config\.php|cms-config\.example\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:json|log)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
